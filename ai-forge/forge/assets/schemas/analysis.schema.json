{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "analyses/<TICKET>.json (one file per ticket, written by the assignee's runner)",
  "type": "object",
  "required": ["schema", "ticket_key", "owner", "group_id", "classification", "root_cause", "confidence", "analyzed_at", "base_commit"],
  "properties": {
    "schema": {"const": 1},
    "ticket_key": {"type": "string"},
    "summary": {"type": "string"},
    "component": {"type": ["string", "null"]},
    "sprint": {"type": ["string", "null"]},
    "owner": {"type": "string"},
    "group_id": {"type": "string"},
    "group_tickets": {"type": "array", "items": {"type": "string"}},
    "classification": {"enum": ["code_bug", "configuration", "environment", "data_issue", "user_error", "duplicate", "needs_info"]},
    "error_signature": {"type": ["string", "null"]},
    "root_cause": {"type": "string"},
    "evidence": {"type": "array"},
    "affected_symbols": {"type": "array", "items": {"type": "string"}},
    "affected_files": {"type": "array", "items": {"type": "string"}},
    "proposed_fix": {"type": ["object", "null"]},
    "non_code_resolution": {"type": ["object", "null"]},
    "regression_of": {"type": ["string", "null"]},
    "duplicate_of": {"type": ["string", "null"]},
    "conflicts": {"type": "array"},
    "risk": {"enum": ["low", "medium", "high"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["awaiting_decision", "approved", "rejected", "info_sent", "resolved", "fixed", "fix_failed", "needs_info"]},
    "pr_url": {"type": ["string", "null"]},
    "fix_commit": {"type": ["string", "null"]},
    "agent": {"type": "string"},
    "model": {"type": "string"},
    "tokens": {"type": "object", "properties": {"input": {"type": ["integer", "null"]}, "output": {"type": ["integer", "null"]}, "estimated": {"type": "integer"}}},
    "base_commit": {"type": "string"},
    "analyzed_at": {"type": "string"}
  }
}
