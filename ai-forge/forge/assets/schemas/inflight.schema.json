{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inflight/<TICKET>.json (written by the owner's runner while a fix is planned/in progress)",
  "type": "object",
  "required": ["schema", "ticket_key", "owner", "status", "updated"],
  "properties": {
    "schema": {"const": 1},
    "ticket_key": {"type": "string"},
    "owner": {"type": "string"},
    "status": {"enum": ["planned", "fixing", "pr_open", "merged", "abandoned"]},
    "branch": {"type": ["string", "null"]},
    "base_commit": {"type": "string"},
    "planned_symbols": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "changed_symbols": {"type": "array", "items": {"type": "string"}},
    "pr_url": {"type": ["string", "null"]},
    "merge_commit": {"type": ["string", "null"]},
    "updated": {"type": "string"}
  }
}
