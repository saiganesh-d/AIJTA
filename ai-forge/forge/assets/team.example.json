{
  "schema": 1,
  "tool_version": "0.2.0",
  "jira": {
    "mode": "api",
    "base_url": "https://yourorg.atlassian.net",
    "api_version": "3",
    "scope_jql": "project = SUP AND statusCategory != Done",
    "support_issue_types": [
      "Support",
      "Bug",
      "Incident",
      "Service Request"
    ],
    "support_labels": [
      "support"
    ],
    "post_comments": false,
    "verify_tls": true,
    "sprint_field": "customfield_10020",
    "max_attachment_mb": 10,
    "allow_closed_for_eval": false
  },
  "base_ref": "origin/main",
  "index": {
    "code_ext": {},
    "config_ext": []
  },
  "models": {
    "forge-doctor": "auto",
    "forge-config": "auto",
    "forge-analyst": "auto",
    "forge-fixer": "auto",
    "forge-adapter": "auto",
    "escalation": "auto"
  },
  "budget": {
    "daily_tokens": 400000,
    "monthly_tokens": 0
  },
  "thresholds": {
    "dedup_similarity": 0.88,
    "group_similarity": 0.8,
    "group_symbol_jaccard": 0.5,
    "max_group_size": 4,
    "context_budget_tokens": 7000,
    "min_confidence_for_fix_card": 0.5,
    "escalate_below_confidence": 0.5,
    "new_ticket_cooldown_minutes": 10
  },
  "context": {
    "past_tickets": true,
    "max_past_tickets": 3,
    "min_past_score": 0.3,
    "git_ticket_map": true,
    "recent_changes_days": 14,
    "recent_changes_max_commits": 5,
    "recent_changes_diff_lines": 20,
    "all_comments": true,
    "past_evidence": true,
    "past_evidence_min_score": 0.5,
    "past_evidence_max_blocks": 2,
    "learn_gaps": true,
    "attachment_files": true,
    "attachment_files_max_mb": 10
  },
  "test": {
    "full": "pytest -q",
    "targeted": "pytest -q {test_path}"
  },
  "delivery": {
    "push": false,
    "pull_request": false
  },
  "work_hours": {
    "start": "09:00",
    "end": "20:00",
    "days": [
      1,
      2,
      3,
      4,
      5
    ]
  },
  "savings": {
    "minutes_triage_per_ticket": 15,
    "minutes_root_cause_per_code_bug": 90,
    "minutes_resolution_per_non_code": 30,
    "minutes_fix_per_pr": 60,
    "engineer_hourly_cost": 0,
    "currency": "EUR",
    "baseline_tokens_per_ticket": 0
  },
  "teams": {
    "channel_hint": "AI Forge Support"
  }
}
